{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title_clean",
    "summary",
    "key_points",
    "action_items",
    "tags",
    "category",
    "platform"
  ],
  "properties": {
    "title_clean": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "key_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "ai_tools",
        "product_insights",
        "video_notes",
        "reference_library",
        "industry_observations"
      ]
    },
    "platform": {
      "type": "string",
      "enum": [
        "website",
        "video",
        "audio",
        "wechat",
        "document",
        "image"
      ]
    }
  }
}
